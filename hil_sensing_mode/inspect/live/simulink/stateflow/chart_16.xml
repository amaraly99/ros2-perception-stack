        <P Name="script">function y = sim_clock_writer(t)
%#codegen
% CRITICAL: this block must live inside Simulink, not in a MATLAB timer.
% It executes only when Simulink steps, so the Pi sees a frozen
% sim_heartbeat exactly when the simulator is paused / errored / hung.
    coder.extrinsic(&apos;assignin&apos;);
    assignin(&apos;base&apos;, &apos;sim_heartbeat&apos;, double(t));
    y = t;
end</P>
