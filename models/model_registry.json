{
  "schema_version": 1,
  "_comment": [
    "Single source of truth for the plug-and-play YOLO framework.",
    "On-disk filenames are INCONSISTENT across families (yolov11n.hef vs yolo11n.onnx,",
    "*_nms_config.json only ships for v8), so generic indexers cannot glob reliably.",
    "This registry maps each logical id -> concrete artifact paths + metadata.",
    "Paths are RELATIVE to this file's directory (the models/ root).",
    "layout/postproc hints are advisory: the predictors still auto-detect from the",
    "actual tensor shapes/names at load time and use these values only as a fallback."
  ],
  "defaults": {
    "input_size": 640,
    "classes": 80,
    "reg_max": 16,
    "conf": 0.20,
    "iou": 0.45
